# =============================================================================
# Valkey SERVER image — REBUILT FROM BITNAMI'S BUILD SCRIPTS (issue #2030, opt 3)
#
# This is our own copy of Bitnami's `bitnami/valkey` Dockerfile. It does NOT
# compile Valkey: Bitnami packages a prebuilt binary tarball and publishes it on
# downloads.bitnami.com/files/stacksmith, which is STILL served after the
# Aug-2025 container-registry deprecation. We rebuild the image from those
# scripts and republish it to our own registry, so the Bitnami Helm chart /
# valkey-operator keep working unchanged (identical /opt/bitnami layout, uid 1001).
#
# The build context is the vendored Bitnami build dir (prebuildfs + rootfs +
# checksums), e.g. git/containers/bitnami/valkey/9.1/debian-12:
#   docker build -f docker/from-bitnami/Dockerfile.valkey \
#     --build-arg TARGETARCH=arm64 \
#     -t valkey:9.1.2 git/containers/bitnami/valkey/9.1/debian-12
#
# Differences from the upstream Bitnami Dockerfile:
#   - the component download no longer uses a BuildKit `--mount=type=secret`, so
#     the image also builds with the legacy Docker builder; DOWNLOADS_URL stays
#     overridable via --build-arg (e.g. to point at an internal mirror).
#   - the base image is a build-arg and the OCI labels point at this fork.
# Everything else is byte-for-byte Bitnami, to preserve the chart runtime contract.
# =============================================================================

# SPDX-License-Identifier: APACHE-2.0

ARG BASE_IMAGE="docker.io/bitnami/minideb:bookworm"

FROM ${BASE_IMAGE}

ARG DOWNLOADS_URL="https://downloads.bitnami.com/files/stacksmith"
ARG TARGETARCH

LABEL org.opencontainers.image.base.name="docker.io/bitnami/minideb:bookworm" \
      org.opencontainers.image.description="Valkey rebuilt from Bitnami's build scripts (issue #2030)" \
      org.opencontainers.image.source="https://github.com/jaroslav-viravec/containers/tree/main/bitnami/valkey" \
      org.opencontainers.image.title="valkey" \
      org.opencontainers.image.version="9.1.2"

ENV HOME="/" \
    OS_ARCH="${TARGETARCH:-amd64}" \
    OS_FLAVOUR="debian-12" \
    OS_NAME="linux"

COPY prebuildfs /
SHELL ["/bin/bash", "-o", "errexit", "-o", "nounset", "-o", "pipefail", "-c"]
# Install required system packages and dependencies
RUN install_packages ca-certificates curl libgcc-s1 libgomp1 libssl3 libstdc++6 procps
# Download + checksum-verify + extract the prebuilt Bitnami components. No compile.
RUN mkdir -p /tmp/bitnami/pkg/cache/ ; cd /tmp/bitnami/pkg/cache/ || exit 1 ; \
    COMPONENTS=( \
      "wait-for-port-1.0.11-3-linux-${OS_ARCH}-debian-12" \
      "valkey-9.1.2-0-linux-${OS_ARCH}-debian-12" \
    ) ; \
    for COMPONENT in "${COMPONENTS[@]}"; do \
      if [ ! -f "${COMPONENT}.tar.gz" ]; then \
        curl -SsLf "${DOWNLOADS_URL}/${COMPONENT}.tar.gz" -O ; \
      fi ; \
      sha256sum -c "/opt/bitnami/checksums/${COMPONENT}.tar.gz.sha256" ; \
      tar -zxf "${COMPONENT}.tar.gz" -C /opt/bitnami --strip-components=2 --no-same-owner ; \
      rm -rf "${COMPONENT}".tar.gz ; \
    done ; \
    rm -rf /opt/bitnami/checksums ;
RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists /var/cache/apt/archives
RUN chmod g+rwX /opt/bitnami
RUN find / -perm /6000 -type f -exec chmod a-s {} \; || true
RUN ln -s /opt/bitnami/scripts/valkey/entrypoint.sh /entrypoint.sh
RUN ln -s /opt/bitnami/scripts/valkey/run.sh /run.sh
RUN uninstall_packages curl

COPY rootfs /
RUN /opt/bitnami/scripts/valkey/postunpack.sh
ENV APP_VERSION="9.1.2" \
    BITNAMI_APP_NAME="valkey" \
    PATH="/opt/bitnami/common/bin:/opt/bitnami/valkey/bin:$PATH"

EXPOSE 6379

USER 1001
ENTRYPOINT [ "/opt/bitnami/scripts/valkey/entrypoint.sh" ]
CMD [ "/opt/bitnami/scripts/valkey/run.sh" ]
