# =============================================================================
# Valkey SENTINEL image — REBUILT FROM BITNAMI'S BUILD SCRIPTS (issue #2030, opt 3)
#
# Our own copy of Bitnami's `bitnami/valkey-sentinel` Dockerfile. Like the server
# image it does NOT compile anything: it downloads a prebuilt binary tarball from
# downloads.bitnami.com/files/stacksmith (still served post Aug-2025 deprecation)
# and republishes to our registry, keeping the Bitnami chart / valkey-operator
# contract intact (/opt/bitnami layout, uid 1001).
#
# The build context is the vendored Bitnami build dir, e.g.
# git/containers/bitnami/valkey-sentinel/9.1/debian-12:
#   docker build -f docker/from-bitnami/Dockerfile.sentinel \
#     --build-arg TARGETARCH=arm64 \
#     -t valkey-sentinel:9.1.2 git/containers/bitnami/valkey-sentinel/9.1/debian-12
#
# Differences from the upstream Bitnami Dockerfile:
#   - the component download no longer uses a BuildKit `--mount=type=secret`, so
#     the image also builds with the legacy Docker builder; DOWNLOADS_URL stays
#     overridable via --build-arg.
#   - the base image is a build-arg and the OCI labels point at this fork.
# Everything else is byte-for-byte Bitnami, to preserve the chart runtime contract.
# =============================================================================

# SPDX-License-Identifier: APACHE-2.0

ARG BASE_IMAGE="docker.io/bitnami/minideb:bookworm"

FROM ${BASE_IMAGE}

ARG DOWNLOADS_URL="https://downloads.bitnami.com/files/stacksmith"
ARG TARGETARCH

LABEL org.opencontainers.image.base.name="docker.io/bitnami/minideb:bookworm" \
      org.opencontainers.image.description="Valkey Sentinel rebuilt from Bitnami's build scripts (issue #2030)" \
      org.opencontainers.image.source="https://github.com/jaroslav-viravec/containers/tree/main/bitnami/valkey-sentinel" \
      org.opencontainers.image.title="valkey-sentinel" \
      org.opencontainers.image.version="9.1.2"

ENV HOME="/" \
    OS_ARCH="${TARGETARCH:-amd64}" \
    OS_FLAVOUR="debian-12" \
    OS_NAME="linux" \
    PATH="/opt/bitnami/valkey-sentinel/bin:$PATH"

COPY prebuildfs /
SHELL ["/bin/bash", "-o", "errexit", "-o", "nounset", "-o", "pipefail", "-c"]
# Install required system packages and dependencies
RUN install_packages ca-certificates curl libssl3 procps
# Download + checksum-verify + extract the prebuilt Bitnami component. No compile.
RUN mkdir -p /tmp/bitnami/pkg/cache/ ; cd /tmp/bitnami/pkg/cache/ || exit 1 ; \
    COMPONENTS=( \
      "valkey-sentinel-9.1.2-0-linux-${OS_ARCH}-debian-12" \
    ) ; \
    for COMPONENT in "${COMPONENTS[@]}"; do \
      if [ ! -f "${COMPONENT}.tar.gz" ]; then \
        curl -SsLf "${DOWNLOADS_URL}/${COMPONENT}.tar.gz" -O ; \
      fi ; \
      sha256sum -c "/opt/bitnami/checksums/${COMPONENT}.tar.gz.sha256" ; \
      tar -zxf "${COMPONENT}.tar.gz" -C /opt/bitnami --strip-components=2 --no-same-owner ; \
      rm -rf "${COMPONENT}".tar.gz ; \
    done ; \
    rm -rf /opt/bitnami/checksums ;
RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists /var/cache/apt/archives
RUN chmod g+rwX /opt/bitnami
RUN find / -perm /6000 -type f -exec chmod a-s {} \; || true
RUN uninstall_packages curl

COPY rootfs /
RUN /opt/bitnami/scripts/valkey-sentinel/postunpack.sh
ENV APP_VERSION="9.1.2" \
    BITNAMI_APP_NAME="valkey-sentinel"

EXPOSE 26379

USER 1001
ENTRYPOINT [ "/opt/bitnami/scripts/valkey-sentinel/entrypoint.sh" ]
CMD [ "/opt/bitnami/scripts/valkey-sentinel/run.sh" ]
